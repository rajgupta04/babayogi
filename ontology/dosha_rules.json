  "prakriti_dual_types": {
    "_description": "Most people have dual-dosha constitutions (Dvandvaja Prakriti). These are the six most common types and their dietary focus. Rare Sama Prakriti (equal all three) is the seventh. Source: Charaka Samhita Vimana 8.",
    "vata_pitta": {
      "primary_traits": "Thin build with sharp mind. Irregular appetite but strong when hungry. Creative but can be anxious and irritable.",
      "dietary_focus": "Warm, nourishing, moderately spiced. Avoid extremes of hot and cold. Sweet, sour tastes are best. Avoid excessive bitter and pungent.",
      "key_rasas": ["madhura", "amla"],
      "avoid_rasas": ["katu"],
      "priority_dosha_to_watch": "Balance whichever is currently aggravated; Vata in cold/dry seasons, Pitta in hot seasons."
    },
    "pitta_kapha": {
      "primary_traits": "Medium to sturdy build. Strong digestion. Determined and steady but can be possessive and angry.",
      "dietary_focus": "Moderate meals, not too heavy or oily. Bitter and astringent tastes help both. Avoid excessive sweet, sour, salty.",
      "key_rasas": ["tikta", "kashaya"],
      "avoid_rasas": ["amla", "lavana"],
      "priority_dosha_to_watch": "Pitta in summer; Kapha in spring and early winter."
    },
    "vata_kapha": {
      "primary_traits": "Can be thin or heavy (variable). Slow digestion, prone to cold. Gentle and creative but may lack motivation.",
      "dietary_focus": "Warm, light, well-spiced foods. Moderate oils (not excessive). Pungent taste helps both doshas. Avoid cold and heavy foods.",
      "key_rasas": ["katu", "madhura"],
      "avoid_rasas": ["kashaya"],
      "priority_dosha_to_watch": "Vata in cold seasons; Kapha in spring. Warm and light food serves both."
    },
    "pitta_vata": {
      "primary_traits": "Medium build, sharp features, intense. Strong appetite, can burn out. Goal-oriented and competitive.",
      "dietary_focus": "Similar to Vata-Pitta but prioritize cooling Pitta first since Pitta tends to be more disruptive. Sweet taste is best for both.",
      "key_rasas": ["madhura"],
      "avoid_rasas": ["katu", "amla"],
      "priority_dosha_to_watch": "Pitta in summer; Vata in winter."
    },
    "kapha_pitta": {
      "primary_traits": "Sturdy, strong build. Good stamina and digestion. Calm but can be stubborn and possessive.",
      "dietary_focus": "Similar to Pitta-Kapha. Light and slightly dry. Bitter taste is universally helpful.",
      "key_rasas": ["tikta", "kashaya"],
      "avoid_rasas": ["madhura", "amla", "lavana"],
      "priority_dosha_to_watch": "Kapha in spring; Pitta in summer."
    },
    "kapha_vata": {
      "primary_traits": "Variable build. Slow metabolism but nervous energy. Can feel cold easily. Loyal and creative.",
      "dietary_focus": "Similar to Vata-Kapha. Warm and lightly spiced. Moderate portions. Sweet and pungent tastes in balance.",
      "key_rasas": ["katu"],
      "avoid_rasas": ["kashaya", "tikta"],
      "priority_dosha_to_watch": "Kapha in spring; Vata in winter and monsoon."
    }
  }
